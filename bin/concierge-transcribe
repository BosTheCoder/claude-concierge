#!/usr/bin/env bash
# concierge-transcribe [--timestamps] <audio-or-video-file> — print a transcript.
#
# --timestamps starts each sentence with [mm:ss], to line speech up with the
# frames of a screen recording (concierge/recording.py).
#
# Telegram delivers voice messages as opus .oga with no transcript. There is no
# local whisper on this box, so this converts to mp3 and sends it to Gemini via
# OpenRouter, which accepts audio inline. Prints the transcript on stdout.
set -euo pipefail

# Before parsing: it re-execs this script with "$@", so a shift would be lost.
# shellcheck disable=SC1091
source "$HOME/.claude/lib/load-secrets.sh"

PROMPT="Transcribe this voice note verbatim. Output only the transcript text, nothing else."
MODEL="google/gemini-2.5-flash"
if [[ "${1:-}" == "--timestamps" ]]; then
  PROMPT='Transcribe the audio above with timestamps. Put each sentence on its own line, prefixed with its start time in [mm:ss] format, e.g. "[00:03] Hello there." Output only those lines. If nobody speaks, output (silence).'
  MODEL="google/gemini-3.8-flash"  # hears "Claude" where 2.5 wrote "cloud"
  shift
fi
if [[ $# -ne 1 ]]; then
  echo "usage: concierge-transcribe [--timestamps] <audio-file>" >&2
  exit 2
fi

AUDIO="$1"
[[ -r "$AUDIO" ]] || { echo "concierge-transcribe: cannot read $AUDIO" >&2; exit 1; }

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
ffmpeg -y -loglevel error -i "$AUDIO" -vn -ar 16000 -ac 1 -b:a 64k "$TMP/voice.mp3"

PROMPT="$PROMPT" MODEL="$MODEL" python3 - "$TMP/voice.mp3" <<'PY'
import base64, json, os, sys, urllib.error, urllib.request

audio = base64.b64encode(open(sys.argv[1], "rb").read()).decode()
body = {
    "model": os.environ["MODEL"],
    "messages": [{"role": "user", "content": [
        # Audio first: with the instruction first, Gemini dropped the [mm:ss] stamps (2026-11-17).
        {"type": "input_audio", "input_audio": {"data": audio, "format": "mp3"}},
        {"type": "text", "text": os.environ["PROMPT"]},
    ]}],
}
req = urllib.request.Request(
    "https://openrouter.ai/api/v1/chat/completions",
    data=json.dumps(body).encode(),
    headers={
        "Authorization": "Bearer " + os.environ["OPENROUTER_API_KEY"],
        "Content-Type": "application/json",
    },
)
try:
    resp = json.load(urllib.request.urlopen(req, timeout=180))
except urllib.error.HTTPError as exc:
    sys.exit(f"concierge-transcribe: OpenRouter {exc.code}: {exc.read().decode()[:500]}")
print(resp["choices"][0]["message"]["content"].strip())
PY
