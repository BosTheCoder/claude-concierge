#!/usr/bin/env bash
# Stable entry point for job sessions and the concierge. Jobs call:
#   concierge notify A3 "done" --file report.md --status done
set -euo pipefail

REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

# Scheduled tasks reach this without a login shell — on Windows, `wsl.exe -- …`
# runs no ~/.zshrc at all — so PATH is the bare system default and `uv` is not
# on it. Everything the concierge starts inherits this environment: tmux, and
# through it `claude` and the channel plugin's `bun server.ts`. This is the one
# place worth fixing, so add whatever your tools need here. Missing entries
# cost nothing. Defaults cover uv (~/.local/bin), Homebrew/Linuxbrew (claude,
# node) and bun.
export PATH="$HOME/.local/bin:/home/linuxbrew/.linuxbrew/bin:/opt/homebrew/bin:$HOME/.bun/bin:$PATH"

exec uv run --project "$REPO" python -m concierge.cli "$@"
